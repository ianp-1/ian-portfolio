---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <a
    href="#top"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-[0.8125rem] focus:text-paper"
  >
    Skip to content
  </a>

  <Nav />

  <main id="top" tabindex="-1" class="outline-none">
    <Hero />
    <Work />
    <Experience />
    <Skills />
    <Contact />
  </main>

  <Footer />
</Base>
