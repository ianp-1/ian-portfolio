---
interface Props {
  id: string;
  title: string;
  /** Optional inline mono annotation — real metadata only, never a decorative eyebrow. */
  meta?: string;
}
const { id, title, meta } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:px-10 md:py-28">
  <div class="section-head reveal relative mb-10 flex items-baseline justify-between gap-4 border-b border-line pb-4">
    <h2 class="font-sans text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.02em] text-ink">
      {title}
    </h2>
    {meta && <span class="font-mono text-[0.8125rem] text-muted">{meta}</span>}
  </div>
  <slot />
</section>

<style>
  /* Accent glint: when the section header reveals, its hairline draws in
     accent left-to-right, then fades back to the neutral rule. A passing
     voice, not a persistent color. */
  .section-head::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .section-head.is-visible::after {
      animation: rule-glint 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    }
  }
  @keyframes rule-glint {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    55% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
</style>
