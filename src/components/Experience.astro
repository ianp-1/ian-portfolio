---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="experience" title="Experience">
  <ol class="flex flex-col">
    {
      experience.map((entry) => {
        const { company, role, period, highlights } = entry.data;
        return (
          <li class="reveal grid grid-cols-1 gap-x-10 gap-y-3 border-b border-line py-8 last:border-b-0 md:grid-cols-[20ch_1fr] md:items-baseline">
            <span class="font-mono text-[0.8125rem] text-muted">{period}</span>
            <div>
              <h3 class="font-sans text-[1.125rem] font-medium leading-snug tracking-[-0.01em] text-ink">
                {role}
              </h3>
              <p class="mt-1 font-sans text-[0.95rem] text-muted">{company}</p>
              <ul class="mt-5 flex flex-col gap-2.5">
                {highlights.map((h) => (
                  <li class="flex gap-3 font-sans text-[0.95rem] leading-relaxed text-muted">
                    {/* 0.78em = optical center of the first line box (1.625 line-height) */}
                    <span aria-hidden="true" class="mt-[0.78em] h-px w-3 shrink-0 bg-line" />
                    <span class="max-w-[62ch]">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>
