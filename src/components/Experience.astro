---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="experience" title="Experience">
  <div class="mb-10 overflow-hidden rounded-lg border border-line bg-surface">
    <canvas
      id="exp-oscilloscope"
      class="block h-28 w-full select-none"
      style="touch-action: pan-y;"
      aria-hidden="true"
    ></canvas>
  </div>

  <ol class="flex flex-col">
    {
      experience.map((entry, idx) => {
        const { company, role, period, highlights } = entry.data;
        return (
          <li
            class="exp-row reveal relative grid grid-cols-1 gap-x-10 gap-y-3 border-b border-line py-8 pl-4 last:border-b-0 md:grid-cols-[22ch_1fr] md:items-baseline md:pl-5"
            data-exp-idx={idx}
            data-exp-active={idx === 0 ? "true" : "false"}
          >
            <span class="exp-period font-mono text-sm tabular-nums text-muted">
              {period}
            </span>
            <div>
              <h3 class="font-sans text-body font-semibold leading-snug tracking-[-0.01em] text-ink">
                {role}
              </h3>
              <p
                data-exp-company
                class="mt-1 font-sans text-body font-medium text-muted"
              >
                {company}
              </p>
              <ul class="mt-5 flex flex-col gap-2.5">
                {highlights.map((h) => (
                  <li class="flex gap-3 font-sans text-body leading-relaxed text-muted">
                    {/* 0.78em = optical center of the first line box */}
                    <span
                      aria-hidden="true"
                      class="mt-[0.78em] h-px w-3 shrink-0 bg-line"
                    />
                    <span class="max-w-[62ch]">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>

<script>
  import {
    mountExperienceOscilloscope,
    type OscilloscopeHandle,
  } from "../lib/project-ascii";

  const canvas = document.getElementById("exp-oscilloscope");
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".exp-row"));
  let activeIdx = 0;

  function setActiveRow(idx: number) {
    if (idx < 0 || idx >= rows.length) return;
    activeIdx = idx;
    rows.forEach((row, i) => {
      row.dataset.expActive = i === idx ? "true" : "false";
    });
  }

  let osc: OscilloscopeHandle | null = null;
  if (canvas instanceof HTMLCanvasElement && rows.length > 0) {
    const labels = rows.map(
      (row) =>
        row.querySelector<HTMLElement>("[data-exp-company]")?.textContent?.trim() ??
        "",
    );
    try {
      osc = mountExperienceOscilloscope(canvas, rows.length, labels);
      osc.setHoverCallback((idx) => {
        setActiveRow(idx);
      });
      window.addEventListener("pagehide", () => osc?.destroy(), { once: true });
    } catch {
      // Keep experience timeline readable if canvas initialization fails.
    }
  }

  rows.forEach((row) => {
    const idx = Number(row.dataset.expIdx ?? -1);
    if (Number.isNaN(idx) || idx < 0) return;

    const activate = () => {
      if (activeIdx !== idx) {
        setActiveRow(idx);
        osc?.setRoleIndex(idx);
      }
    };

    row.addEventListener("mouseenter", activate);
    row.addEventListener("focusin", activate);
    row.addEventListener("click", activate);
  });
</script>

<style>
  .exp-row {
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exp-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2rem;
    bottom: 2rem;
    width: 1.5px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }
  .exp-row[data-exp-active="true"] {
    background-color: color-mix(in oklab, var(--surface) 50%, transparent);
  }
  .exp-row[data-exp-active="true"]::before,
  .exp-row:hover::before,
  .exp-row:focus-within::before {
    transform: scaleY(1);
    opacity: 1;
  }
  .exp-period {
    transition: color 0.18s ease;
  }
  .exp-row[data-exp-active="true"] .exp-period {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-row,
    .exp-period {
      transition: color 0.16s ease, background-color 0.16s ease;
    }
    .exp-row::before {
      transition: opacity 0.16s ease;
      transform: none;
    }
  }
</style>
