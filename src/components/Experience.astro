---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const firstEntry = experience[0]?.data;
const initialValueText = firstEntry
  ? `${firstEntry.company} — ${firstEntry.role} (${firstEntry.period})`
  : undefined;
---

<Section id="experience" title="Experience">
  <div class="exp-sticky-bar sticky top-16 z-20 -mx-2 mb-8 px-2 py-2">
    <div class="exp-osc-shell overflow-hidden rounded-lg border border-line bg-surface">
      <canvas
        id="exp-oscilloscope"
        role="slider"
        tabindex="0"
        aria-label="Experience timeline scrubber"
        aria-valuemin="1"
        aria-valuemax={experience.length}
        aria-valuenow="1"
        aria-valuetext={initialValueText}
        class="block h-20 w-full cursor-ew-resize select-none focus-visible:outline-none"
        style="touch-action: pan-y;"
      ></canvas>
    </div>
  </div>

  <ol class="flex flex-col">
    {
      experience.map((entry, idx) => {
        const { company, role, period, highlights } = entry.data;
        return (
          <li
            class="exp-row reveal relative grid grid-cols-1 gap-x-10 gap-y-3 border-b border-line py-8 pl-4 last:border-b-0 md:grid-cols-[22ch_1fr] md:items-baseline md:pl-5"
            data-exp-idx={idx}
            data-exp-active={idx === 0 ? "true" : "false"}
          >
            <span class="exp-period font-mono text-sm tabular-nums text-muted">
              {period}
            </span>
            <div>
              <h3
                data-exp-role
                class="font-sans text-body font-semibold leading-snug tracking-[-0.01em] text-ink"
              >
                {role}
              </h3>
              <p
                data-exp-company
                class="mt-1 font-sans text-body font-medium text-muted"
              >
                {company}
              </p>
              <ul class="mt-5 flex flex-col gap-2.5">
                {highlights.map((h) => (
                  <li class="flex gap-3 font-sans text-body leading-relaxed text-muted">
                    {/* 0.78em = optical center of the first line box */}
                    <span
                      aria-hidden="true"
                      class="mt-[0.78em] h-px w-3 shrink-0 bg-line"
                    />
                    <span class="max-w-[62ch]">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>

<script>
  import {
    mountExperienceOscilloscope,
    type OscilloscopeHandle,
  } from "../lib/project-ascii";

  const stickyBar = document.querySelector<HTMLElement>(".exp-sticky-bar");
  const canvas = document.getElementById("exp-oscilloscope");
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".exp-row"));
  const labels = rows.map(
    (row) =>
      row.querySelector<HTMLElement>("[data-exp-company]")?.textContent?.trim() ??
      "",
  );
  const roles = rows.map(
    (row) =>
      row.querySelector<HTMLElement>("[data-exp-role]")?.textContent?.trim() ??
      "",
  );
  const periods = rows.map(
    (row) =>
      row.querySelector<HTMLElement>(".exp-period")?.textContent?.trim() ?? "",
  );

  let activeIdx = 0;
  let isScrubbing = false;
  let scrubStartNorm = 0;
  let didDragScrub = false;
  let programmaticScrollUntil = 0;

  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  const clampValue = (v: number, min: number, max: number) =>
    Math.max(min, Math.min(max, v));

  function getAnchorY(): number {
    const stickyTop = stickyBar
      ? parseFloat(getComputedStyle(stickyBar).top) || 64
      : 64;
    const barH = stickyBar?.offsetHeight ?? 96;
    return stickyTop + barH + 16;
  }

  function setActiveRow(idx: number) {
    if (idx < 0 || idx >= rows.length) return;
    activeIdx = idx;
    rows.forEach((row, i) => {
      row.dataset.expActive = i === idx ? "true" : "false";
    });
    if (canvas instanceof HTMLCanvasElement) {
      canvas.setAttribute("aria-valuenow", String(idx + 1));
      canvas.setAttribute(
        "aria-valuetext",
        `${labels[idx] ?? ""} — ${roles[idx] ?? ""} (${periods[idx] ?? ""})`,
      );
    }
  }

  function getMaxScroll(): number {
    return Math.max(
      0,
      document.documentElement.scrollHeight - window.innerHeight,
    );
  }

  function scrollToRole(idx: number, smooth: boolean) {
    const row = rows[idx];
    if (!row) return;
    const targetY = clampValue(
      window.scrollY + row.getBoundingClientRect().top - getAnchorY(),
      0,
      getMaxScroll(),
    );
    const useSmooth = smooth && !reducedMotionQuery.matches;
    programmaticScrollUntil = performance.now() + (useSmooth ? 550 : 80);
    window.scrollTo({
      top: targetY,
      behavior: useSmooth ? "smooth" : "auto",
    });
  }

  function scrollToNorm(normX: number) {
    if (rows.length === 0) return;
    const clamped = clampValue(normX, 0, 1);
    const scaled = clamped * rows.length;
    const idx = Math.min(rows.length - 1, Math.floor(scaled));
    const local = scaled - idx;
    const row = rows[idx]!;
    const rowDocTop = window.scrollY + row.getBoundingClientRect().top;

    let docTarget = rowDocTop;
    if (idx < rows.length - 1) {
      const nextDocTop =
        window.scrollY + rows[idx + 1]!.getBoundingClientRect().top;
      docTarget = rowDocTop + local * (nextDocTop - rowDocTop);
    } else {
      docTarget = rowDocTop + local * Math.min(row.offsetHeight * 0.35, 80);
    }

    programmaticScrollUntil = performance.now() + 80;
    window.scrollTo({
      top: clampValue(docTarget - getAnchorY(), 0, getMaxScroll()),
      behavior: "auto",
    });
  }

  let osc: OscilloscopeHandle | null = null;
  if (canvas instanceof HTMLCanvasElement && rows.length > 0) {
    try {
      osc = mountExperienceOscilloscope(
        canvas,
        rows.length,
        labels,
        periods,
        roles,
      );
      osc.setHoverCallback((idx) => {
        setActiveRow(idx);
      });
      osc.setScrubCallback((normX, idx, phase) => {
        if (phase === "start") {
          isScrubbing = true;
          scrubStartNorm = normX;
          didDragScrub = false;
          setActiveRow(idx);
        } else if (phase === "move") {
          if (Math.abs(normX - scrubStartNorm) > 0.006) {
            didDragScrub = true;
          }
          setActiveRow(idx);
          if (didDragScrub) {
            scrollToNorm(normX);
          }
        } else {
          isScrubbing = false;
          if (!didDragScrub) {
            scrollToRole(idx, true);
            osc?.setScrollProgress((idx + 0.5) / rows.length);
          } else {
            programmaticScrollUntil = performance.now() + 80;
            setActiveRow(idx);
          }
        }
      });
    } catch {
      // Keep experience timeline readable if canvas initialization fails.
    }
  }

  const syncFromScroll = () => {
    if (rows.length === 0) return;
    if (isScrubbing || performance.now() < programmaticScrollUntil) return;
    const firstRect = rows[0]!.getBoundingClientRect();
    const lastRect = rows[rows.length - 1]!.getBoundingClientRect();
    if (lastRect.bottom < 0 || firstRect.top > window.innerHeight) return;

    const focusY = getAnchorY() + 24;
    let closestIdx = 0;
    let bestDist = Infinity;
    let bestCenterDist = Infinity;
    let closestLocal = 0;

    for (let i = 0; i < rows.length; i++) {
      const rect = rows[i]!.getBoundingClientRect();
      const dist =
        focusY < rect.top
          ? rect.top - focusY
          : focusY > rect.bottom
            ? focusY - rect.bottom
            : 0;
      const centerDist = Math.abs(rect.top + rect.height * 0.5 - focusY);
      if (
        dist < bestDist ||
        (dist === bestDist && centerDist < bestCenterDist)
      ) {
        bestDist = dist;
        bestCenterDist = centerDist;
        closestIdx = i;
        closestLocal = Math.max(
          0,
          Math.min(1, (focusY - rect.top) / Math.max(1, rect.height)),
        );
      }
    }

    const progress = Math.max(
      0,
      Math.min(1, (closestIdx + closestLocal) / rows.length),
    );

    if (activeIdx !== closestIdx) {
      setActiveRow(closestIdx);
      osc?.setRoleIndex(closestIdx);
    }
    osc?.setScrollProgress(progress);
  };

  let scrollRafId: number | null = null;
  const scheduleScrollSync = () => {
    if (scrollRafId !== null) return;
    scrollRafId = requestAnimationFrame(() => {
      scrollRafId = null;
      syncFromScroll();
    });
  };

  const cancelProgrammaticScroll = () => {
    programmaticScrollUntil = 0;
  };

  const onKeyDown = (e: KeyboardEvent) => {
    if (rows.length === 0) return;
    let next = activeIdx;
    if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
      next = Math.max(0, activeIdx - 1);
    } else if (e.key === "ArrowRight" || e.key === "ArrowDown") {
      next = Math.min(rows.length - 1, activeIdx + 1);
    } else if (e.key === "Home") {
      next = 0;
    } else if (e.key === "End") {
      next = rows.length - 1;
    } else {
      return;
    }
    e.preventDefault();
    setActiveRow(next);
    osc?.setRoleIndex(next);
    osc?.setScrollProgress((next + 0.5) / rows.length);
    scrollToRole(next, true);
  };

  window.addEventListener("scroll", scheduleScrollSync, { passive: true });
  window.addEventListener("resize", scheduleScrollSync, { passive: true });
  window.addEventListener("wheel", cancelProgrammaticScroll, { passive: true });
  window.addEventListener("touchstart", cancelProgrammaticScroll, {
    passive: true,
  });
  canvas?.addEventListener("keydown", onKeyDown);
  syncFromScroll();

  rows.forEach((row) => {
    const idx = Number(row.dataset.expIdx ?? -1);
    if (Number.isNaN(idx) || idx < 0) return;

    const activate = () => {
      if (isScrubbing) return;
      if (activeIdx !== idx) {
        setActiveRow(idx);
        osc?.setRoleIndex(idx);
      }
    };

    row.addEventListener("mouseenter", activate);
    row.addEventListener("focusin", activate);
    row.addEventListener("click", activate);
  });

  const onPageHide = (event: PageTransitionEvent) => {
    if (event.persisted) return;
    if (scrollRafId !== null) {
      cancelAnimationFrame(scrollRafId);
      scrollRafId = null;
    }
    window.removeEventListener("scroll", scheduleScrollSync);
    window.removeEventListener("resize", scheduleScrollSync);
    window.removeEventListener("wheel", cancelProgrammaticScroll);
    window.removeEventListener("touchstart", cancelProgrammaticScroll);
    canvas?.removeEventListener("keydown", onKeyDown);
    window.removeEventListener("pagehide", onPageHide);
    osc?.destroy();
    osc = null;
  };
  window.addEventListener("pagehide", onPageHide);
</script>

<style>
  .exp-sticky-bar {
    background-color: color-mix(in oklab, var(--paper) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .exp-osc-shell:has(#exp-oscilloscope:focus-visible) {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .exp-row {
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .exp-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 2rem;
    bottom: 2rem;
    width: 1.5px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease;
  }
  .exp-row[data-exp-active="true"] {
    background-color: color-mix(in oklab, var(--surface) 50%, transparent);
  }
  .exp-row[data-exp-active="true"]::before,
  .exp-row:hover::before,
  .exp-row:focus-within::before {
    transform: scaleY(1);
    opacity: 1;
  }
  .exp-period {
    transition: color 0.18s ease;
  }
  .exp-row[data-exp-active="true"] .exp-period {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-row,
    .exp-period {
      transition: color 0.16s ease, background-color 0.16s ease;
    }
    .exp-row::before {
      transition: opacity 0.16s ease;
      transform: none;
    }
  }
</style>
