---
// Custom cursor — the site's one indulgence, built from the same accent voice.
// A small dot tracks the pointer; a hairline ring blooms only over
// interactive elements. Activates exclusively for fine pointers with motion
// allowed; everyone else keeps the native cursor untouched.
---

<div id="cursor-dot" aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<style>
  #cursor-dot,
  #cursor-ring {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50; /* above nav (40); nothing sits higher */
    pointer-events: none;
    border-radius: 999px;
    opacity: 0;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #cursor-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }
  #cursor-ring {
    width: 36px;
    height: 36px;
    border: 1.5px solid color-mix(in oklab, var(--accent) 65%, transparent);
  }
  /* Compositor hint only while the custom cursor is actually live */
  :global(html.custom-cursor) #cursor-dot,
  :global(html.custom-cursor) #cursor-ring {
    will-change: transform;
  }
  /* Visible only while the custom cursor is live and the pointer is on-page */
  :global(html.custom-cursor.cursor-on) #cursor-dot {
    opacity: 1;
  }
  :global(html.custom-cursor.cursor-on.cursor-link) #cursor-ring {
    opacity: 1;
  }
  /* Hide the native cursor only when we're drawing our own */
  :global(html.custom-cursor),
  :global(html.custom-cursor *) {
    cursor: none;
  }
</style>

<script>
  const dot = document.getElementById("cursor-dot");
  const ring = document.getElementById("cursor-ring");
  const root = document.documentElement;

  const fine = window.matchMedia("(pointer: fine) and (hover: hover)");
  const noMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (dot && ring) {
    let raf = 0;
    let running = false;
    let tx = -100, ty = -100; // pointer target
    let dx = -100, dy = -100; // dot position (fast follow)
    let rx = -100, ry = -100; // ring position (soft follow)
    let ds = 1, rs = 0.6;     // current scales
    let overLink = false;
    let pressed = false;
    // DOM work (closest / elementFromPoint / classList) is deferred to the
    // rAF tick so input events stay cheap no matter how fast they fire.
    let pendingTarget: Element | null = null;
    let needsHitTest = false;

    const INTERACTIVE = "a, button, [role='button'], summary, label";
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function frame() {
      if (needsHitTest) {
        // Scrolling moves the page under a stationary pointer — recheck
        // what's beneath it so the ring doesn't linger on a link.
        pendingTarget = document.elementFromPoint(tx, ty);
        needsHitTest = false;
      }
      if (pendingTarget !== null) {
        overLink = !!pendingTarget.closest?.(INTERACTIVE);
        root.classList.toggle("cursor-link", overLink);
        pendingTarget = null;
      }

      dx = lerp(dx, tx, 0.6);
      dy = lerp(dy, ty, 0.6);
      rx = lerp(rx, tx, 0.16);
      ry = lerp(ry, ty, 0.16);
      const dTarget = overLink ? 0.5 : 1;
      const rTarget = overLink ? (pressed ? 0.85 : 1) : 0.6;
      ds = lerp(ds, dTarget, 0.22);
      rs = lerp(rs, rTarget, 0.18);
      dot!.style.transform = `translate3d(${dx}px, ${dy}px, 0) translate(-50%, -50%) scale(${ds})`;
      ring!.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%) scale(${rs})`;

      // Everything converged and no work queued → let the loop sleep until
      // the next input event wakes it. No idle 60fps burn.
      const settled =
        Math.abs(tx - dx) + Math.abs(ty - dy) < 0.1 &&
        Math.abs(tx - rx) + Math.abs(ty - ry) < 0.1 &&
        Math.abs(ds - dTarget) < 0.005 &&
        Math.abs(rs - rTarget) < 0.005;
      if (settled) {
        running = false;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function wake() {
      if (!running) {
        running = true;
        raf = requestAnimationFrame(frame);
      }
    }

    const onMove = (e: MouseEvent) => {
      tx = e.clientX;
      ty = e.clientY;
      pendingTarget = e.target as Element | null;
      if (!root.classList.contains("cursor-on")) root.classList.add("cursor-on");
      wake();
    };
    const onScroll = () => {
      needsHitTest = true;
      wake();
    };
    const onLeave = () => root.classList.remove("cursor-on");
    const onDown = () => {
      pressed = true;
      wake();
    };
    const onUp = () => {
      pressed = false;
      wake();
    };

    function enable() {
      root.classList.add("custom-cursor");
      // Snap into place so the first frames don't streak across the page
      dx = rx = tx;
      dy = ry = ty;
      document.addEventListener("mousemove", onMove, { passive: true });
      document.addEventListener("mousedown", onDown, { passive: true });
      document.addEventListener("mouseup", onUp, { passive: true });
      document.documentElement.addEventListener("mouseleave", onLeave);
      window.addEventListener("scroll", onScroll, { passive: true });
      wake();
    }

    function disable() {
      root.classList.remove("custom-cursor", "cursor-on", "cursor-link");
      document.removeEventListener("mousemove", onMove);
      document.removeEventListener("mousedown", onDown);
      document.removeEventListener("mouseup", onUp);
      document.documentElement.removeEventListener("mouseleave", onLeave);
      window.removeEventListener("scroll", onScroll);
      cancelAnimationFrame(raf);
      running = false;
    }

    const sync = () => {
      if (fine.matches && !noMotion.matches) enable();
      else disable();
    };
    sync();
    fine.addEventListener("change", sync);
    noMotion.addEventListener("change", sync);
  }
</script>
