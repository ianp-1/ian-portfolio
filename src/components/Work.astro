---
import { getCollection } from "astro:content";
import Section from "./Section.astro";
import type { ProjectSpecimenId } from "../lib/project-ascii";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const VALID_SPECIMENS = new Set<ProjectSpecimenId>(["nadir", "canopy", "obscurafy"]);

function toSpecimenId(rawId: string): ProjectSpecimenId {
  const normalized = rawId.replace(/\.md$/i, "").toLowerCase();
  if (VALID_SPECIMENS.has(normalized as ProjectSpecimenId)) {
    return normalized as ProjectSpecimenId;
  }
  return "nadir";
}

const specimens = projects.map((project) => ({
  id: toSpecimenId(project.id),
  title: project.data.title,
}));

const initialSpecimen = specimens[0] ?? {
  id: "nadir" as ProjectSpecimenId,
  title: "Nadir",
};
---

<Section id="work" title="Selected work" meta={`${projects.length} projects`}>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_minmax(320px,400px)] lg:items-start">
    <ul class="flex flex-col">
      {
        projects.map((project, idx) => {
          const { title, description, tags, award, code, demo } = project.data;
          const href = demo ?? code ?? "#";
          const specimenId = toSpecimenId(project.id);
          const [awardPrize, awardEvent] = award
            ? award.split("·").map((part) => part.trim())
            : [];
          return (
            <li class="reveal border-b border-line last:border-b-0">
              <a
                href={href}
                target="_blank"
                rel="noopener"
                data-project-specimen={specimenId}
                data-active={idx === 0 ? "true" : "false"}
                class="work-row group relative block rounded-md px-3 py-6"
              >
                <h3 class="work-title inline-flex items-center gap-2 font-sans text-body font-semibold tracking-[-0.01em] text-ink">
                  {title}
                  <span class="work-arrow text-accent" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <path d="M7 17L17 7M17 7H7M17 7V17" />
                    </svg>
                  </span>
                </h3>
                <p class="mt-2 max-w-[58ch] font-sans text-body leading-relaxed text-muted">
                  {description}
                </p>
                <p class="mt-3 font-mono text-sm text-muted">
                  {tags.join(" · ")}
                </p>
                {awardPrize && (
                  <p class="mt-2 font-mono text-sm leading-snug">
                    <span class="font-medium text-ink">{awardPrize}</span>
                    {awardEvent && <span class="text-muted"> · {awardEvent}</span>}
                  </p>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>

    <aside aria-label="Project ASCII specimen" class="lg:sticky lg:top-28">
      <div class="overflow-hidden rounded-md border border-line bg-surface">
        <canvas
          id="work-ascii-canvas"
          class="block aspect-[4/3] w-full"
          aria-hidden="true"
        ></canvas>

        <div class="flex flex-col gap-3 border-t border-line bg-paper px-4 py-3.5">
          <div class="flex items-baseline justify-between gap-3">
            <span
              id="work-specimen-title"
              class="font-sans text-body font-semibold text-ink"
            >
              {initialSpecimen.title}
            </span>
          </div>

          <div
            role="radiogroup"
            aria-label="Select project specimen"
            class="flex items-center gap-1 rounded-md border border-line bg-surface p-1"
          >
            {
              specimens.map((specimen, idx) => (
                <label class="specimen-option relative flex-auto cursor-pointer">
                  <input
                    type="radio"
                    name="work-specimen"
                    value={specimen.id}
                    checked={idx === 0}
                    data-specimen-radio={specimen.id}
                    data-specimen-title={specimen.title}
                    class="specimen-input sr-only"
                  />
                  <span class="specimen-pill block rounded-[4px] px-2.5 py-1.5 text-center font-mono text-sm font-medium text-muted">
                    {specimen.title}
                  </span>
                </label>
              ))
            }
          </div>
        </div>
      </div>
    </aside>
  </div>
</Section>

<script>
  import { mountProjectAscii, type ProjectSpecimenId } from "../lib/project-ascii";

  const canvas = document.getElementById("work-ascii-canvas");
  const titleEl = document.getElementById("work-specimen-title");
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project-specimen]"),
  );
  const radios = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-specimen-radio]"),
  );

  const validIds = new Set<ProjectSpecimenId>(["nadir", "canopy", "obscurafy"]);
  const firstRadio = radios[0]?.dataset.specimenRadio;
  let activeId: ProjectSpecimenId =
    firstRadio && validIds.has(firstRadio as ProjectSpecimenId)
      ? (firstRadio as ProjectSpecimenId)
      : "nadir";

  let handle: ReturnType<typeof mountProjectAscii> | null = null;
  if (canvas instanceof HTMLCanvasElement) {
    try {
      handle = mountProjectAscii(canvas, activeId);
      window.addEventListener("pagehide", () => handle?.destroy(), { once: true });
    } catch {
      // Keep project list and selector usable if WebGL initialization fails.
    }
  }

  function selectSpecimen(id: ProjectSpecimenId) {
    if (!validIds.has(id) || id === activeId) return;
    activeId = id;

    rows.forEach((row) => {
      row.dataset.active = row.dataset.projectSpecimen === id ? "true" : "false";
    });

    let nextTitle = "";
    radios.forEach((radio) => {
      const match = radio.dataset.specimenRadio === id;
      radio.checked = match;
      if (match) {
        nextTitle = radio.dataset.specimenTitle ?? "";
      }
    });

    if (titleEl && nextTitle) {
      titleEl.textContent = nextTitle;
    }

    handle?.setProject(id);
  }

  rows.forEach((row) => {
    const id = row.dataset.projectSpecimen as ProjectSpecimenId | undefined;
    if (!id || !validIds.has(id)) return;
    row.addEventListener("mouseenter", () => selectSpecimen(id));
    row.addEventListener("focusin", () => selectSpecimen(id));
  });

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (!radio.checked) return;
      const id = radio.dataset.specimenRadio as ProjectSpecimenId | undefined;
      if (id && validIds.has(id)) {
        selectSpecimen(id);
      }
    });
  });
</script>

<style>
  .work-row {
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.18s ease;
  }
  .work-row[data-active="true"] {
    background-color: var(--surface);
  }
  .work-row[data-active="true"]::before,
  .work-row:hover::before,
  .work-row:focus-visible::before {
    transform: scaleY(1);
    opacity: 1;
  }
  .work-row:hover {
    transform: translateY(-2px);
    box-shadow: var(--hover-shadow);
    background-color: var(--surface);
  }

  .work-title {
    position: relative;
    transition: color 0.18s ease;
  }
  .work-title::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-row:hover .work-title,
  .work-row:focus-visible .work-title {
    color: var(--accent);
  }
  .work-row:hover .work-title::after,
  .work-row:focus-visible .work-title::after {
    clip-path: inset(0 0 0 0);
  }

  .work-arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-row:hover .work-arrow,
  .work-row:focus-visible .work-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .specimen-pill {
    transition:
      background-color 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .specimen-option:hover .specimen-pill {
    color: var(--ink);
  }
  .specimen-input:checked + .specimen-pill {
    background-color: var(--ink);
    color: var(--paper);
  }
  .specimen-input:focus-visible + .specimen-pill {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row,
    .work-row::before,
    .work-title,
    .work-title::after,
    .work-arrow,
    .specimen-pill {
      transition: color 0.18s ease, background-color 0.18s ease;
      transform: none !important;
    }
    .work-arrow {
      opacity: 1;
    }
  }
</style>
