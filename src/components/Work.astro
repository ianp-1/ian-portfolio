---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

type ExhibitId = "nadir" | "canopy" | "obscurafy";

const VALID_EXHIBITS = new Set<ExhibitId>(["nadir", "canopy", "obscurafy"]);

function toExhibitId(rawId: string): ExhibitId {
  const normalized = rawId.replace(/\.md$/i, "").toLowerCase();
  if (VALID_EXHIBITS.has(normalized as ExhibitId)) {
    return normalized as ExhibitId;
  }
  return "nadir";
}
---

<Section id="work" title="Selected work" meta={`${projects.length} projects`}>
  <div class="flex flex-col divide-y divide-line">
    {
      projects.map((project, idx) => {
        const { title, description, tags, award, code, demo } = project.data;
        const href = demo ?? code ?? "#";
        const exhibitId = toExhibitId(project.id);
        const isReversed = idx % 2 === 1;
        const [awardPrize, awardEvent] = award
          ? award.split("·").map((part) => part.trim())
          : [];

        return (
          <article
            class:list={[
              "reveal grid grid-cols-1 items-center gap-8 py-12 first:pt-2 last:pb-2 lg:gap-12 lg:py-16",
              isReversed
                ? "lg:grid-cols-[minmax(280px,0.9fr)_minmax(0,1.35fr)]"
                : "lg:grid-cols-[minmax(0,1.35fr)_minmax(280px,0.9fr)]",
            ]}
          >
            <div class:list={["min-w-0", isReversed && "lg:order-2"]}>
              <div class="work-exhibit relative overflow-hidden rounded-lg border border-line bg-surface">
                <canvas
                  class="block aspect-[16/10] w-full min-h-[260px] select-none"
                  style="touch-action: pan-y;"
                  data-exhibit={exhibitId}
                  aria-hidden="true"
                />
              </div>
            </div>

            <div
              class:list={[
                "readable-glass flex min-w-0 flex-col items-start rounded-xl p-6 md:p-7",
                isReversed && "lg:order-1",
              ]}
            >
              <h3 class="font-sans text-heading font-semibold leading-[1.15] tracking-[-0.02em] text-ink">
                {title}
              </h3>
              <p class="mt-4 max-w-[46ch] font-sans text-body leading-relaxed text-muted">
                {description}
              </p>
              <p class="mt-4 font-mono text-sm text-muted">
                {tags.join(" · ")}
              </p>
              {awardPrize && (
                <p class="mt-3 font-mono text-sm leading-snug">
                  <span class="font-medium text-ink">{awardPrize}</span>
                  {awardEvent && <span class="text-muted"> · {awardEvent}</span>}
                </p>
              )}
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="work-code-link mt-6 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-ink hover:text-accent"
              >
                <span class="work-code-label">View code</span>
                <span class="work-code-arrow text-accent" aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</Section>

<script>
  import {
    mountNadirExhibit,
    mountCanopyExhibit,
    mountObscurafyExhibit,
    type DestroyableHandle,
  } from "../lib/project-ascii";

  const canvases = Array.from(
    document.querySelectorAll<HTMLCanvasElement>("[data-exhibit]"),
  );
  const handles: DestroyableHandle[] = [];

  for (const canvas of canvases) {
    const id = canvas.dataset.exhibit;
    if (id !== "nadir" && id !== "canopy" && id !== "obscurafy") continue;

    try {
      if (id === "nadir") {
        handles.push(mountNadirExhibit(canvas));
      } else if (id === "canopy") {
        handles.push(mountCanopyExhibit(canvas));
      } else {
        handles.push(mountObscurafyExhibit(canvas));
      }
    } catch {
      // Keep project descriptions and links usable if canvas initialization fails.
    }
  }

  if (handles.length > 0) {
    window.addEventListener(
      "pagehide",
      () => {
        handles.forEach((handle) => handle.destroy());
      },
      { once: true },
    );
  }
</script>

<style>
  .work-exhibit {
    content-visibility: auto;
    contain-intrinsic-size: auto none auto 340px;
    transition:
      border-color 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-exhibit:hover {
    border-color: color-mix(in oklab, var(--accent) 42%, var(--line));
    box-shadow: var(--hover-shadow);
  }

  .work-code-link {
    transition: color 0.18s ease;
  }
  .work-code-label {
    position: relative;
  }
  .work-code-label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    height: 1.5px;
    width: 100%;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-code-link:hover .work-code-label::after,
  .work-code-link:focus-visible .work-code-label::after {
    clip-path: inset(0 0 0 0);
  }

  .work-code-arrow {
    display: inline-block;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-code-link:hover .work-code-arrow,
  .work-code-link:focus-visible .work-code-arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-exhibit,
    .work-code-link,
    .work-code-label::after,
    .work-code-arrow {
      transition: color 0.18s ease, border-color 0.18s ease;
    }
    .work-code-link:hover .work-code-arrow,
    .work-code-link:focus-visible .work-code-arrow {
      transform: none;
    }
  }
</style>
