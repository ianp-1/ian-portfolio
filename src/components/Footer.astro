---
import { SITE } from "../data/site";
const year = 2026;
---

<footer class="relative z-10 mx-auto max-w-5xl px-6 pb-10 md:px-10">
  <div class="readable-glass flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-xl px-5 py-4">
    <p class="font-mono text-sm text-muted">
      © {year} {SITE.name}
    </p>
    <a
      href="#top"
      class="footer-top-link font-mono text-sm text-muted hover:text-ink"
    >
      Back to top ↑
    </a>
  </div>
</footer>

<style>
  .footer-top-link {
    transition: color 0.18s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-top-link {
      transition: none;
    }
  }
</style>
