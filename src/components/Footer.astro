---
import { SITE } from "../data/site";
const year = 2026;
---

<footer class="mx-auto max-w-5xl px-6 pb-10 md:px-10">
  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6">
    <p class="font-mono text-[0.75rem] text-muted">
      © {year} {SITE.name}
    </p>
    <a
      href="#top"
      class="font-mono text-[0.75rem] text-muted transition-colors hover:text-ink"
    >
      back to top ↑
    </a>
  </div>
</footer>
