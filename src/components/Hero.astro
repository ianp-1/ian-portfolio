---
import { SITE, LINKS } from "../data/site";
---

<section
  id="hero"
  data-hero-surface
  class="hero-section relative min-h-[100svh] w-full overflow-hidden"
>
  <div class="hero-paper-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <canvas
    id="hero-fluid-canvas"
    class="absolute inset-0 h-full w-full select-none"
    style="touch-action: pan-y;"
    aria-hidden="true"
  ></canvas>

  <h1 class="sr-only">{SITE.name}</h1>

  <noscript>
    <div class="pointer-events-none absolute inset-x-0 top-[24vh] z-10 flex justify-center px-6 text-center">
      <p class="font-sans text-[clamp(3.5rem,12vw,8.5rem)] font-semibold uppercase leading-[0.9] tracking-[-0.04em] text-ink">
        IAN PANG
      </p>
    </div>
  </noscript>

  <div
    class="pointer-events-none relative z-10 mx-auto flex min-h-[100svh] w-full max-w-6xl flex-col justify-end px-6 pb-8 pt-24 md:px-10 md:pb-12"
  >
    <div
      id="hero-horizon"
      class="flex w-full flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
    >
      <div id="hero-copy" class="hero-copy pointer-events-auto max-w-xl">
        <a
          href={LINKS.resume}
          target="_blank"
          rel="noopener"
          class="btn-primary group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-sans text-body font-medium text-paper"
        >
          View résumé
          <svg
            class="btn-arrow group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            aria-hidden="true"
          >
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-paper-veil {
    background: linear-gradient(
      to bottom,
      var(--paper) 0%,
      var(--paper) 58%,
      color-mix(in oklab, var(--paper) 78%, transparent) 72%,
      color-mix(in oklab, var(--paper) 38%, transparent) 85%,
      color-mix(in oklab, var(--paper) 10%, transparent) 94%,
      transparent 100%
    );
  }
  #hero-fluid-canvas {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.68) 80%,
      rgba(0, 0, 0, 0.22) 91%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.68) 80%,
      rgba(0, 0, 0, 0.22) 91%,
      transparent 100%
    );
  }
  .btn-primary {
    transition:
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    opacity: 0.88;
  }
  .btn-arrow {
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-primary,
    .btn-arrow {
      transition: opacity 0.18s ease;
    }
    .btn-primary:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>

<script>
  import { mountHeroAscii, type HeroAsciiHandle } from "../lib/ascii-engine";

  const canvas = document.getElementById("hero-fluid-canvas");
  const clearElement = document.getElementById("hero-horizon");

  let engine: HeroAsciiHandle | null = null;

  if (canvas instanceof HTMLCanvasElement) {
    try {
      engine = mountHeroAscii(canvas, { clearElement });
    } catch {
      // Keep static fallback layout accessible if canvas setup fails.
    }
  }

  window.addEventListener(
    "pagehide",
    (event) => {
      if (!event.persisted) {
        engine?.destroy();
        engine = null;
      }
    },
    { once: true },
  );
</script>
