---
import { SITE, LINKS } from "../data/site";

const sections = [
  { id: "work", label: "work" },
  { id: "experience", label: "experience" },
  { id: "skills", label: "skills" },
  { id: "contact", label: "contact" },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-40 transition-colors duration-300">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 md:px-10"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="font-sans text-[0.95rem] font-semibold tracking-tight text-ink transition-colors hover:text-accent"
    >
      {SITE.name}
    </a>

    <div class="flex items-center gap-5 md:gap-7">
      <ul class="hidden items-center gap-6 md:flex">
        {
          sections.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                data-nav-link={s.id}
                class="nav-link font-mono text-[0.8125rem] font-medium text-muted transition-colors hover:text-ink"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={LINKS.resume}
        target="_blank"
        rel="noopener"
        class="nav-link hidden font-mono text-[0.8125rem] font-medium text-muted transition-colors hover:text-ink md:inline-flex md:items-center md:gap-1"
      >
        resume
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" />
        </svg>
      </a>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle color theme"
        class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:text-ink"
      >
        <svg class="theme-icon-light size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="theme-icon-dark size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:text-ink md:hidden"
      >
        <svg class="menu-icon-open size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 9h16M4 15h16" />
        </svg>
        <svg class="menu-icon-close hidden size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu: flows beneath the bar inside the fixed header -->
  <div id="mobile-menu" hidden class="border-t border-line px-6 pb-4 md:hidden">
    <ul class="flex flex-col">
      {
        sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              data-mobile-link
              class="block border-b border-line py-4 font-mono text-[0.9375rem] font-medium text-ink"
            >
              {s.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={LINKS.resume}
          target="_blank"
          rel="noopener"
          data-mobile-link
          class="flex items-center gap-1.5 py-4 font-mono text-[0.9375rem] font-medium text-ink"
        >
          resume
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M7 17L17 7M17 7H7M17 7V17" />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  #site-nav {
    background: color-mix(in oklab, var(--paper) 100%, transparent);
  }
  /* Hairline + subtle backdrop appear only once scrolled past the hero. */
  #site-nav.scrolled {
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  /* Open menu always needs solid ground, scrolled or not. */
  #site-nav.menu-open {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  /* Theme icon is CSS-driven off [data-theme], which the no-FOUC script
     sets before first paint — so the correct icon renders immediately. */
  .theme-icon-dark {
    display: none;
  }
  :global([data-theme="dark"]) .theme-icon-dark {
    display: block;
  }
  :global([data-theme="dark"]) .theme-icon-light {
    display: none;
  }

  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1.5px;
    width: 100%;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="true"]::after {
    clip-path: inset(0 0 0 0);
  }
  .nav-link[aria-current="true"] {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const root = document.documentElement;

  // ── Theme toggle ──────────────────────────────────────────────────
  const toggle = document.getElementById("theme-toggle");
  const themeMeta = document.getElementById("meta-theme-color");

  function applyTheme(theme: string) {
    root.setAttribute("data-theme", theme);
    // Keep the browser chrome color in step with the --paper token
    themeMeta?.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#ffffff");
    toggle?.setAttribute("aria-pressed", String(theme === "dark"));
  }
  toggle?.setAttribute(
    "aria-pressed",
    String(root.getAttribute("data-theme") === "dark"),
  );

  toggle?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    applyTheme(next);
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  // ── Nav background after scrolling past the top ───────────────────
  const nav = document.getElementById("site-nav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 32);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // ── Mobile menu ───────────────────────────────────────────────────
  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.querySelector<HTMLElement>(".menu-icon-open");
  const iconClose = document.querySelector<HTMLElement>(".menu-icon-close");

  function setMenu(open: boolean) {
    if (!menu || !menuToggle) return;
    menu.hidden = !open;
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    nav?.classList.toggle("menu-open", open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  menuToggle?.addEventListener("click", () => setMenu(menu?.hidden ?? false));
  menu?.querySelectorAll("[data-mobile-link]").forEach((link) =>
    link.addEventListener("click", () => setMenu(false)),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) {
      setMenu(false);
      menuToggle?.focus();
    }
  });
  // Close if the viewport grows past the mobile breakpoint
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // ── Active-section indicator ──────────────────────────────────────
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );
  const byId = new Map(links.map((l) => [l.dataset.navLink, l]));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          links.forEach((l) => l.removeAttribute("aria-current"));
          byId.get(entry.target.id)?.setAttribute("aria-current", "true");
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
  );
  ["work", "experience", "skills", "contact"].forEach((id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });
</script>
