---
import { SITE, LINKS } from "../data/site";

const socials = [
  { label: "GitHub", href: LINKS.github, external: true },
  { label: "LinkedIn", href: LINKS.linkedin, external: true },
  { label: "Résumé", href: LINKS.resume, external: true },
];
---

<section id="contact" class="mx-auto max-w-5xl scroll-mt-24 px-6 py-24 md:px-10 md:py-32">
  <canvas
    id="horizon-ascii-canvas"
    class="mb-10 block h-20 w-full select-none"
    style="touch-action: pan-y;"
    aria-hidden="true"
  ></canvas>

  <h2 class="max-w-2xl font-sans text-heading font-semibold leading-[1.1] tracking-[-0.02em] text-ink">
    Let's build something.
  </h2>

  <a
    href={LINKS.email}
    class="email-link group mt-8 inline-flex items-center gap-3 font-sans text-heading font-medium tracking-[-0.02em] text-ink"
  >
    <span class="email-text">{SITE.email}</span>
    <span class="email-arrow text-accent" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
    </span>
  </a>

  <div class="mt-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target={s.external ? "_blank" : undefined}
            rel={s.external ? "noopener noreferrer" : undefined}
            class="link-underline font-mono text-sm font-medium text-muted hover:text-ink"
          >
            {s.label}
          </a>
        ))
      }
    </div>
    <p class="font-mono text-sm text-muted">
      {SITE.location}
    </p>
  </div>
</section>

<script>
  import { mountHorizonAscii } from "../lib/project-ascii";

  const canvas = document.getElementById("horizon-ascii-canvas");
  if (canvas instanceof HTMLCanvasElement) {
    try {
      const handle = mountHorizonAscii(canvas);
      window.addEventListener("pagehide", () => handle.destroy(), { once: true });
    } catch {
      // Keep contact section usable if canvas initialization fails.
    }
  }
</script>

<style>
  .email-text {
    position: relative;
    transition: color 0.18s ease;
  }
  .email-text::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.36s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .email-link:hover .email-text,
  .email-link:focus-visible .email-text {
    color: var(--accent);
  }
  .email-link:hover .email-text::after,
  .email-link:focus-visible .email-text::after {
    clip-path: inset(0 0 0 0);
  }

  .email-arrow {
    opacity: 0;
    transform: translate(-8px, 4px);
    transition:
      transform 0.26s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.26s ease;
  }
  .email-link:hover .email-arrow,
  .email-link:focus-visible .email-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .link-underline {
    position: relative;
    transition: color 0.18s ease;
  }
  .link-underline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -3px;
    height: 1.5px;
    width: 100%;
    background: var(--accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .link-underline:hover::after,
  .link-underline:focus-visible::after {
    clip-path: inset(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .email-text,
    .email-text::after,
    .email-arrow,
    .link-underline,
    .link-underline::after {
      transition: color 0.18s ease;
    }
    .email-arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
