---
import "../styles/global.css";
import { SITE } from "../data/site";
import Cursor from "../components/Cursor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} — ${SITE.role}`,
  description = SITE.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta id="meta-theme-color" name="theme-color" content="#ffffff" />

    <!-- Preload every weight the first viewport renders (hero meta, h1, tagline, CTA) -->
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-500.woff2" as="font" type="font/woff2" crossorigin />

    <!-- No-FOUC theme: resolve before first paint -->
    <script is:inline>
      (function () {
        var theme = "light";
        try {
          var stored = localStorage.getItem("theme");
          theme =
            stored === "dark" || stored === "light"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
        var meta = document.getElementById("meta-theme-color");
        // #0a0a0a / #ffffff mirror the --paper token in each theme
        if (meta) meta.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#ffffff");
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <slot />
    <Cursor />
  </body>
</html>
