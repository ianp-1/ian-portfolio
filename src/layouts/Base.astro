---
import "../styles/global.css";
import { SITE } from "../data/site";
import Cursor from "../components/Cursor.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} | ${SITE.role}`,
  description = SITE.tagline,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta id="meta-color-scheme" name="color-scheme" content="dark" />
    <meta id="meta-theme-color" name="theme-color" content="#080808" />

    <!-- Preload every weight the first viewport renders -->
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-500.woff2" as="font" type="font/woff2" crossorigin />

    <!-- No-FOUC theme: default to Obsidian Ink ("dark") before first paint -->
    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            theme = stored;
          }
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
        var schemeMeta = document.getElementById("meta-color-scheme");
        if (schemeMeta) schemeMeta.setAttribute("content", theme);
        var meta = document.getElementById("meta-theme-color");
        if (meta) meta.setAttribute("content", theme === "dark" ? "#080808" : "#FAFAFA");
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body>
    <slot />
    <canvas
      id="ascii-nanobot-canvas"
      class="pointer-events-none fixed inset-0 z-20 h-full w-full select-none"
      aria-hidden="true"
    ></canvas>
    <Cursor />

    <script>
      import {
        mountAsciiNanobots,
        type NanobotHandle,
      } from "../lib/ascii-nanobots";

      const canvas = document.getElementById("ascii-nanobot-canvas");
      let handle: NanobotHandle | null = null;

      if (canvas instanceof HTMLCanvasElement) {
        try {
          handle = mountAsciiNanobots(canvas);
        } catch {
          // Keep page content visible if nanobot canvas initialization fails.
        }
      }

      if (handle) {
        const onPageHide = (event: PageTransitionEvent) => {
          if (!event.persisted) {
            handle?.destroy();
            handle = null;
            window.removeEventListener("pagehide", onPageHide);
          }
        };
        window.addEventListener("pagehide", onPageHide);
      }
    </script>
  </body>
</html>
